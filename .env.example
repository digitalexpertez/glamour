PORT=3000

# Paste your MongoDB Atlas connection string here in your local .env file.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=your_database_name

# Set each value to the exact collection name in Atlas for that star rating.
MONGO_COLLECTION_1=reviews_1_star
MONGO_COLLECTION_2=reviews_2_star
MONGO_COLLECTION_3=reviews_3_star
MONGO_COLLECTION_4=reviews_4_star
MONGO_COLLECTION_5=reviews_5_star

# The server tries this field first, then common alternatives (text, reviewText, content, comment, body).
REVIEW_TEXT_FIELD=review

# Optional: your Google Business review link (HTTPS).
GOOGLE_REVIEW_URL=https://g.page/r/YOUR_GOOGLE_PLACE_ID/review